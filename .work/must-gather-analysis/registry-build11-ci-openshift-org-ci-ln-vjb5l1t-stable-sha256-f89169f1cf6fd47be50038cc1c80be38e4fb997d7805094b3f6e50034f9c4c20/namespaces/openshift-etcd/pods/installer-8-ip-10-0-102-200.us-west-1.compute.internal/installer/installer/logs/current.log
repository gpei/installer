2026-01-28T09:44:05.950293966Z           --target-name=ip-10-0-102-200.us-west-1.compute.internal)
2026-01-28T09:44:05.950293966Z         export ETCD_INITIAL_CLUSTER
2026-01-28T09:44:05.950293966Z 
2026-01-28T09:44:05.950293966Z         # we cannot use the "normal" port conflict initcontainer because when we upgrade, the existing static pod will never yield,
2026-01-28T09:44:05.950293966Z         # so we do the detection in etcd container itself.
2026-01-28T09:44:05.950293966Z         echo -n "Waiting for ports 2379, 2380 and 9978 to be released."
2026-01-28T09:44:05.950293966Z         time while [ -n "$(ss -Htan '( sport = 2379 or sport = 2380 or sport = 9978 )')" ]; do
2026-01-28T09:44:05.950293966Z           echo -n "."
2026-01-28T09:44:05.950293966Z           sleep 1
2026-01-28T09:44:05.950293966Z         done
2026-01-28T09:44:05.950293966Z 
