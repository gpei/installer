2026-01-28T09:48:51.105829740Z 
2026-01-28T09:48:51.105829740Z         # we cannot use the "normal" port conflict initcontainer because when we upgrade, the existing static pod will never yield,
2026-01-28T09:48:51.105829740Z         # so we do the detection in etcd container itself.
2026-01-28T09:48:51.105829740Z         echo -n "Waiting for ports 2379, 2380 and 9978 to be released."
